{% comment %}
  WhatsApp Wishlist Share Button
  Place this inside the wishlist tab of the account dashboard.
  Builds a pre-filled WhatsApp message with all wishlist products and opens wa.me.
  No backend or API key required — works via WhatsApp click-to-chat.
{% endcomment %}

<div id="wl-whatsapp-wrap" style="display:none; margin-top:20px;">
  <button id="wl-whatsapp-btn" type="button" class="wl-wa-btn">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
      <path d="M12 0C5.373 0 0 5.373 0 12c0 2.126.556 4.123 1.527 5.856L.057 23.882a.5.5 0 00.606.61l6.198-1.618A11.95 11.95 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22a9.95 9.95 0 01-5.073-1.387l-.361-.214-3.743.977.998-3.648-.235-.374A9.953 9.953 0 012 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/>
    </svg>
    Share Wishlist on WhatsApp
  </button>
</div>

<style>
  .wl-wa-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #25d366;
    color: #fff;
    border: none;
    padding: 12px 24px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: opacity .2s, transform .15s;
  }
  .wl-wa-btn:hover { opacity: .88; transform: translateY(-1px); }
</style>

<script>
(function () {
  var KEY = 'shopify_wishlist';

  function getWishlist() {
    try { return JSON.parse(localStorage.getItem(KEY) || '[]'); }
    catch (e) { return []; }
  }

  function buildWhatsAppURL(items) {
    var shopName = {{ shop.name | json }};
    var lines = ['Hi! Here is my wishlist from ' + shopName + ':\n'];
    items.forEach(function (p, i) {
      lines.push((i + 1) + '. ' + p.title + ' — ' + p.price + '\n   ' + window.location.origin + p.url);
    });
    lines.push('\nPlease help me with these products.');
    var text = encodeURIComponent(lines.join('\n'));
    return 'https://wa.me/?text=' + text;
  }

  function init() {
    var items = getWishlist();
    var wrap = document.getElementById('wl-whatsapp-wrap');
    if (!wrap) return;

    if (items.length > 0) wrap.style.display = 'block';

    document.getElementById('wl-whatsapp-btn').addEventListener('click', function () {
      var latest = getWishlist();
      if (!latest.length) { alert('Your wishlist is empty!'); return; }
      window.open(buildWhatsAppURL(latest), '_blank');
    });

    /* re-show/hide when wishlist changes */
    window.addEventListener('storage', function (e) {
      if (e.key === KEY) {
        var updated = getWishlist();
        wrap.style.display = updated.length ? 'block' : 'none';
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
