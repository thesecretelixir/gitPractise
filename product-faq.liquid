{% schema %}
{
  "name": "Product FAQ",
  "tag": "section",
  "class": "section",
  "settings": [],
  "presets": [
    {
      "name": "Product FAQ"
    }
  ]
}
{% endschema %}

<style>
  .product-faq-wrapper {
    max-width: 100%;
    margin: 50px 150px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .faq-item {
    border: 1px solid #d6dde0;
    border-radius: 8px;
    overflow: hidden;
    background: #fff;
  }

  .faq-question {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 6px;
    text-align: left;
    background: none;
    border: none;
    padding: 18px 20px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    color: #1a3a3a;
  }

  .faq-q-label {
    color: #1a3a3a;
    font-weight: 700;
    flex-shrink: 0;
  }

  .faq-q-text {
    flex: 1;
    color: #1a3a3a;
  }

  .faq-icon {
    font-size: 20px;
    font-weight: 300;
    color: #1a3a3a;
    flex-shrink: 0;
    transition: transform 0.2s ease;
    line-height: 1;
  }

  .faq-question.open .faq-icon {
    transform: rotate(45deg);
  }

  .faq-answer {
    display: none;
    padding: 0 20px 18px 20px;
    font-size: 15px;
    line-height: 1.7;
    color: #444;
    border-top: 1px solid #eef1f2;
  }

  .faq-answer.active {
    display: block;
  }
</style>

<script>
  document.querySelectorAll('.faq-question').forEach((q) => {
    q.addEventListener('click', () => {
      q.classList.toggle('open');
      q.nextElementSibling.classList.toggle('active');
    });
  });
</script>
