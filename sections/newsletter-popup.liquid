{% if template == 'index' %}
  <div id="custom-newsletter-popup" class="newsletter-popup">
    <div class="newsletter-overlay"></div>
    <div class="newsletter-modal">
      <!-- Left Image -->
      <div class="newsletter-image">
        <img src="{{ section.settings.popup_image | image_url: width: 600 }}" alt="Newsletter">
      </div>
      <!-- Right Content -->
      <div class="newsletter-content">
        <button class="popup-close">&times;</button>
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.subtext }}</p>

        {% form 'customer' %}
          {% if form.posted_successfully? %}
            <p class="success-msg">Thanks for subscribing!</p>
          {% else %}
            {% if form.errors %}
              <p class="error-msg">{{ form.errors | default_errors }}</p>
            {% endif %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <input
              type="email"
              name="contact[email]"
              placeholder="Email address"
              required
            >
            <button type="submit">SUBSCRIBE</button>
          {% endif %}
        {% endform %}

        <p class="privacy-text">Your information will never be shared</p>
      </div>
    </div>
  </div>
{% endif %}

<style>
.newsletter-popup {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 9999;
}
.newsletter-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.5);
}
.newsletter-modal {
  position: relative;
  width: 800px;
  max-width: 95%;
  margin: 5% auto;
  background: #fff;
  display: flex;
  border-radius: 10px;
  overflow: hidden;
  animation: popupFade 0.4s ease forwards;
}
@keyframes popupFade {
  from { opacity: 0; transform: translateY(20px); }
  to   { opacity: 1; transform: translateY(0); }
}
.newsletter-image {
  width: 50%;
}
.newsletter-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.newsletter-content {
  width: 50%;
  padding: 40px;
  position: relative;
}
.newsletter-content h2 {
  font-size: 28px;
  margin-bottom: 10px;
  text-align: center;
}
.newsletter-content p {
  text-align: center;
}
.newsletter-content input {
  width: 100%;
  padding: 12px;
  margin-bottom: 15px;
  border: 1px solid #ddd;
  border-radius: 6px;
  box-sizing: border-box;
}
.newsletter-content button[type="submit"] {
  width: 100%;
  padding: 12px;
  background: #000;
  color: #fff;
  border: none;
  border-radius: 6px;
  cursor: pointer;
}
.popup-close {
  position: absolute;
  right: 15px;
  top: 15px;
  font-size: 22px;
  border: none;
  background: #f5f5f5;
  width: 35px;
  height: 35px;
  border-radius: 50%;
  cursor: pointer;
}
.success-msg {
  color: green;
  font-weight: bold;
  text-align: center;
  margin-top: 20px;
}
.error-msg {
  color: red;
  font-size: 14px;
  text-align: center;
}

/* MOBILE RESPONSIVE */
@media (max-width: 768px) {
  .newsletter-modal {
    flex-direction: column;
    width: 70%;
    margin: 50% auto;
    max-height: 90vh;
    overflow-y: auto;
  }
  .newsletter-image {
    width: 100%;
    height: 180px;
  }
  .newsletter-image img {
    height: 180px;
    object-position: top center;
  }
  .newsletter-content {
    width: 100%;
    padding: 10px 15px;
  }
  .newsletter-content h2 {
    font-size: 20px;
    margin-top: 10px;
  }
  .newsletter-content p {
    font-size: 12px;
    margin: 5px 0;
  }
  .popup-close {
    right: 10px;
    top: 10px;
    width: 30px;
    height: 30px;
    font-size: 18px;
  }
  .newsletter-content input {
    padding: 10px;
    margin-bottom: 10px;
  }
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {
  const popup = document.getElementById("custom-newsletter-popup");
  const closeBtn = popup ? popup.querySelector(".popup-close") : null;
  const overlay = popup ? popup.querySelector(".newsletter-overlay") : null;
  const form = popup ? popup.querySelector("form") : null;

  // If already subscribed, do not show popup
  if (localStorage.getItem("newsletterSubscribed") === "true") return;

  // Show popup after 1 second
  if (popup) {
    setTimeout(function () {
      popup.style.display = "block";
      document.body.style.overflow = "hidden";
    }, 1000);
  }

  function closePopup() {
    popup.style.display = "none";
    document.body.style.overflow = "auto";
  }

  if (closeBtn) closeBtn.addEventListener("click", closePopup);
  if (overlay) overlay.addEventListener("click", closePopup);

  // On form submit, mark as subscribed so popup won't show again
  if (form) {
    form.addEventListener("submit", function () {
      localStorage.setItem("newsletterSubscribed", "true");
    });
  }
});
</script>

{% schema %}
{
  "name": "Newsletter Popup",
  "settings": [
    {
      "type": "image_picker",
      "id": "popup_image",
      "label": "Popup Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join Our Mailing List"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Stay informed with monthly tips and discounts."
    }
  ]
}
{% endschema %}
