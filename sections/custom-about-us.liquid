      "label": "Main title",
      "default": "No Exaggerated science."
    },
    {
      "type": "image_picker",
      "id": "hero_gif_1",
      "label": "Polaroid image / GIF 1"
    },
    {
      "type": "image_picker",
      "id": "hero_gif_2",
      "label": "Polaroid image / GIF 2"
    },
    {
      "type": "image_picker",
      "id": "hero_gif_3",
      "label": "Polaroid image / GIF 3"
    },
    {
      "type": "text",
      "id": "hero_eyebrow",
      "label": "Eyebrow text",
      "default": "WHEN WE STARTED WE KNEW WE WANTED TO CREATE"
    },
    {
      "type": "text",
      "id": "hero_title_line1",
      "label": "Title line 1 (Circular Std font)",
      "default": "Just simple &"
    },
    {
      "type": "text",
      "id": "hero_title_line2",
      "label": "Title line 2 (bold)",
      "default": "targeted solutions for"
    },
    {
      "type": "text",
      "id": "hero_title_line3",
      "label": "Title line 3 (italic accent font)",
      "default": "every phase of you"
    },
    {
      "type": "richtext",
      "id": "hero_description",
      "label": "Description",
      "default": "<p>We understand that every body responds differently, and as does progress. It takes time, and consistency is key. That is why we focus on offering solutions for both visible and invisible needs of women at every phase, without overcomplicating or hiding behind jargon. Just honest care, so you can choose what feels right for you.</p>"
    },
    {
      "type": "header",
      "content": "Section 2 — Targeted Solutions"
    },
    {
      "type": "text",
      "id": "targeted_subtitle",
      "label": "Subtitle",
      "default": "BLOOM"
    },
    {
      "type": "text",
      "id": "targeted_title_line1",
      "label": "Title line 1 (bold)",
      "default": "Targeted solutions for"
    },
    {
      "type": "text",
      "id": "targeted_title_line2",
      "label": "Title line 2 (italic accent font)",
      "default": "Every Phase of you."
    },
    {
      "type": "image_picker",
      "id": "targeted_image",
      "label": "Main image"
    },
    {
      "type": "header",
      "content": "Section 4 — Mission"
    },
    {
      "type": "text",
      "id": "mission_subtitle",
      "label": "Subtitle",
      "default": "OUR MISSION"
    },
    {
      "type": "text",
      "id": "mission_title_line1",
      "label": "Title line 1 (italic accent font)",
      "default": "To empower women"
    },
    {
      "type": "text",
      "id": "mission_title_line2",
      "label": "Title line 2 (Circular Std font)",
      "default": "to understand & own their health."
    },
    {
      "type": "richtext",
      "id": "mission_description",
      "label": "Description",
      "default": "<p>We focus on helping women understand how their bodies work, so they can make informed choices with confidence. With honest, thoughtful care, we aim to support both their health and pleasure in a way that feels natural and sustainable.</p>"
    },
    {
      "type": "image_picker",
      "id": "mission_image",
      "label": "Mission image"
    }
  ],
  "blocks": [
    {
      "type": "phase",
      "name": "Phase",
      "settings": [
        {
          "type": "text",
          "id": "phase_label",
          "label": "Phase label",
          "default": "Phase 1"
        },
        {
          "type": "text",
          "id": "phase_title",
          "label": "Phase title",
          "default": "Period Care"
        },
        {
          "type": "textarea",
          "id": "phase_description",
          "label": "Phase description",
          "default": "Not every period feels the same. From PMS to PCOS, we are here with care that supports what your body needs, when it needs it."
        },
        {
          "type": "image_picker",
          "id": "phase_image",
          "label": "Phase image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom About Us",
      "blocks": [
        {
          "type": "phase",
          "settings": {
            "phase_label": "Phase 1",
            "phase_title": "Period Care",
