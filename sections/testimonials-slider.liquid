{% schema %}
{
  "name": "Testimonials Slider",
  "settings": [
    {
      "type": "text",
      "id": "main_heading",
      "label": "Heading",
      "default": "From Our Customers"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "image_picker",
          "id": "product_img",
          "label": "Product Image"
        },
        {
          "type": "textarea",
          "id": "testimonial_text",
          "label": "Testimonial Text",
          "default": "Amazing experience!"
        },
        {
          "type": "image_picker",
          "id": "author_avatar",
          "label": "Author Avatar"
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Author Name",
          "default": "John Doe"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location",
          "default": "Mumbai"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials Slider"
    }
  ]
}
{% endschema %}

<section class="testimonials-section" id="testimonials-{{ section.id }}">
  <div class="container">
    <h2 class="section-title">{{ section.settings.main_heading }}</h2>

    <div class="testimonials-slider">
      <div class="testimonials-track">
        {% for block in section.blocks %}
          <div class="testimonial-slide" {{ block.shopify_attributes }}>
            <div class="testimonial">
              <div class="testimonial-img">
                {% if block.settings.product_img %}
                  <img
                    src="{{ block.settings.product_img | img_url: '600x600' }}"
                    alt="{{ block.settings.author_name | escape }}"
                    loading="lazy"
                  >
                {% endif %}
              </div>
              <div class="testimonial-content">
                <p class="testimonial-text">{{ block.settings.testimonial_text }}</p>
                <div class="testimonial-author">
                  <div class="author-avatar">
                    {% if block.settings.author_avatar %}
                      <img
                        src="{{ block.settings.author_avatar | img_url: '100x100' }}"
                        alt="{{ block.settings.author_name | escape }}"
                        loading="lazy"
                      >
                    {% endif %}
                  </div>
                  <div class="author-info">
                    <h4>{{ block.settings.author_name }}</h4>
                    <p>{{ block.settings.location }}</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>

    <div class="testimonial-nav" id="testimonial-dots-{{ section.id }}">
      {% comment %} Dots are generated by JS so count adapts to desktop vs mobile view {% endcomment %}
    </div>
  </div>
</section>

<style>
  /* ─── Section wrapper ─── */
  .testimonials-section {
    padding: 80px 0;
  }

  .testimonials-section .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .testimonials-section .section-title {
    text-align: center;
    margin-bottom: 50px;
    font-size: clamp(1.5rem, 3vw, 2.2rem);
  }

  /* ─── Slider wrapper ─── */
  .testimonials-slider {
    position: relative;
    overflow: hidden;
    /* Reserve space so focus outlines aren't clipped */
    padding-bottom: 4px;
  }

  /* ─── Track ─── */
  .testimonials-track {
    display: flex;
    transition: transform 0.5s ease;
    will-change: transform;
    align-items: stretch;
  }

  /* ─── Individual slide ─── */
  /* Desktop: 2 per view (each slide = 50% of track width) */
  .testimonial-slide {
    flex: 0 0 50%;
    box-sizing: border-box;
    padding: 0 12px;
  }

  /* ─── Card ─── */
  .testimonial {
    display: flex;
    background-color: #fff;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
    height: 100%;
  }

  .testimonial-img {
    width: 40%;
    flex-shrink: 0;
  }

  .testimonial-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .testimonial-content {
    width: 60%;
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .testimonial-text {
    margin-bottom: 20px;
    line-height: 1.7;
    font-size: 0.95rem;
  }

  .testimonial-author {
    display: flex;
    align-items: center;
  }

  .author-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    margin-right: 14px;
  }

  .author-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .author-info h4 {
    margin: 0 0 4px;
    font-size: 0.95rem;
  }

  .author-info p {
    margin: 0;
    font-size: 0.85rem;
    color: #666;
  }

  /* ─── Dots ─── */
  .testimonial-nav {
    display: flex;
    justify-content: center;
    margin-top: 36px;
    gap: 10px;
  }

  .testimonial-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: #ccc;
    cursor: pointer;
    border: none;
    padding: 0;
    transition: background-color 0.3s ease, transform 0.3s ease;
  }

  .testimonial-dot.active {
    background-color: #111;
    transform: scale(1.2);
  }

  /* ─── Tablet (up to 900px): keep 2-per-view but tighten card ─── */
  @media (max-width: 900px) {
    .testimonial-img {
      width: 35%;
    }

    .testimonial-content {
      width: 65%;
      padding: 20px 16px;
    }

    .testimonial-text {
      font-size: 0.88rem;
    }
  }

  /* ─── Mobile (up to 767px): 1 per view, stacked card ─── */
  @media (max-width: 767px) {
    .testimonials-section {
      padding: 60px 0;
    }

    /* One slide fills full width */
    .testimonial-slide {
      flex: 0 0 100%;
      padding: 0 6px;
    }

    /* Stack image on top of content */
    .testimonial {
      flex-direction: column;
    }

    .testimonial-img {
      width: 100%;
      height: 200px;
    }

    .testimonial-content {
      width: 100%;
      padding: 20px 18px;
    }

    .testimonial-text {
      font-size: 0.9rem;
    }
  }

  /* ─── Small mobile (up to 480px) ─── */
  @media (max-width: 480px) {
    .testimonial-img {
      height: 170px;
    }

    .author-avatar {
      width: 40px;
      height: 40px;
    }
  }
</style>

<script>
(function () {
  var SECTION_ID   = '{{ section.id }}';
  var AUTO_DELAY   = 5000;
  var SWIPE_THRESH = 50;

  document.addEventListener('DOMContentLoaded', function () {
    var section    = document.getElementById('testimonials-' + SECTION_ID);
    if (!section) return;

    var track      = section.querySelector('.testimonials-track');
    var slides     = section.querySelectorAll('.testimonial-slide');
    var dotsWrap   = document.getElementById('testimonial-dots-' + SECTION_ID);
    var totalSlides = slides.length;

    if (totalSlides === 0) return;

    var currentGroup = 0;
    var dots         = [];
    var autoTimer    = null;

    /* ── Helpers ── */
    function itemsPerView() {
      return window.innerWidth >= 768 ? 2 : 1;
    }

    function totalGroups() {
      return Math.ceil(totalSlides / itemsPerView());
    }

    /* ── Build dots ── */
    function buildDots() {
      dotsWrap.innerHTML = '';
      dots = [];
      var count = totalGroups();
      for (var i = 0; i < count; i++) {
        var btn = document.createElement('button');
        btn.className   = 'testimonial-dot' + (i === currentGroup ? ' active' : '');
        btn.setAttribute('aria-label', 'Go to slide group ' + (i + 1));
        btn.dataset.idx = i;
        btn.addEventListener('click', function () {
          goTo(parseInt(this.dataset.idx, 10));
          resetAuto();
        });
        dotsWrap.appendChild(btn);
        dots.push(btn);
      }
    }

    /* ── Move slider ── */
    function goTo(group) {
      var maxGroup = totalGroups() - 1;
      currentGroup = Math.max(0, Math.min(group, maxGroup));

      /* Each slide is (100 / itemsPerView)% wide.
         Moving by one group = moving by itemsPerView slides = 100% of container. */
      track.style.transform = 'translateX(-' + (currentGroup * 100) + '%)';

      dots.forEach(function (dot, i) {
        dot.classList.toggle('active', i === currentGroup);
      });
    }

    /* ── Auto-play ── */
    function startAuto() {
      autoTimer = setInterval(function () {
        var next = (currentGroup + 1) % totalGroups();
        goTo(next);
      }, AUTO_DELAY);
    }

    function resetAuto() {
      clearInterval(autoTimer);
      startAuto();
    }

    /* ── Touch / swipe support ── */
    var touchStartX = 0;
    var touchStartY = 0;

    track.addEventListener('touchstart', function (e) {
      touchStartX = e.touches[0].clientX;
      touchStartY = e.touches[0].clientY;
    }, { passive: true });

    track.addEventListener('touchend', function (e) {
      var dx = e.changedTouches[0].clientX - touchStartX;
      var dy = e.changedTouches[0].clientY - touchStartY;

      /* Only react to horizontal swipes */
      if (Math.abs(dx) < SWIPE_THRESH || Math.abs(dx) < Math.abs(dy)) return;

      if (dx < 0) {
        goTo(currentGroup + 1);
      } else {
        goTo(currentGroup - 1);
      }
      resetAuto();
    }, { passive: true });

    /* ── Recalculate on resize (desktop ↔ mobile switch) ── */
    var resizeTimer;
    window.addEventListener('resize', function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function () {
        /* Clamp currentGroup to new totalGroups */
        currentGroup = Math.min(currentGroup, totalGroups() - 1);
        buildDots();
        goTo(currentGroup);
      }, 200);
    });

    /* ── Init ── */
    buildDots();
    goTo(0);
    startAuto();
  });
}());
</script>
